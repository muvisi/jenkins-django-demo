[Unit]
Description=Jenkins Django Demo
After=network.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/opt/jenkins-django-demo
EnvironmentFile=/etc/jenkins-django-demo.env
ExecStart=/opt/jenkins-django-demo/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8001 config.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
